#include <stdio.h>

int main()
{
    int mat[4][4];
    int soma = 0, somaLinha1 = 0;

    printf("Digite os numeros da matriz:\n");

    for(int i = 0; i < 4; i++) {
        for(int j = 0; j < 4; j++) {
            printf("Posicao [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
        }
    }

    printf("\nMATRIZ 4x4:\n");

    for(int i = 0; i < 4; i++) {
        for(int j = 0; j < 4; j++) {
            printf("|%d\t", mat[i][j]);
        }
        printf("|\n");
    }

    // diagonal principal
    printf("\nDIAGONAL PRINCIPAL:\n");

    for(int i = 0; i < 4; i++) {
        printf("%d ", mat[i][i]);
        soma += mat[i][i];
    }

    // diagonal secundaria
    for(int i = 0; i < 4; i++) {
        somaLinha1 += mat[i][3 - i];
    }

    printf("\nA soma da diagonal principal é: %d\n", soma);
    printf("A soma da diagonal secundaria é: %d\n", somaLinha1);

    return 0;
}
