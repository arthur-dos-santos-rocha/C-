
#include <stdio.h>

int main()
{
	int mat[4][4];
 	int soma=0, somaLinha1 =0,somaLinha2 =0, somaLinha3= 0;

	printf("Digite os numeros da matriz: "); //matriz 3x3

	for(int i=0; i<3; i++) {
		for(int j=0; j<3; j++) {
			printf("As posição [%d][%d]: ", i, j);
			scanf("%d", &mat[i][j]);
		}
	}
	printf("\nMATRIZ 3X3: \n");
	for(int i=0; i<3; i++) {
		for(int j=0; j<3; j++) {
			printf("|%d\t", mat[i][j]);
		}
		printf("|\n");

	}
	//soma matriz
	for(int i=0; i<3; i++) {
		for(int j=0; j<3; j++) {
			soma += mat[i][j];

		}
	}

	//soma linha 1
	for(int j=0; j<3; j++) {
		somaLinha1 += mat[0][j];
	}
	//soma linha 2
	for(int j=0; j<3; j++) {
		somaLinha2 += mat[1][j];
	}
	//soma linha 3
	for(int j=0; j<3; j++) {
		somaLinha3 += mat[2][j];
	}
	

	printf("\nA soma da matriz é: %d\n",soma);
	printf("\nA soma da Linha Um é: %d\n",somaLinha1);
	printf("\nA soma da Linha Dois é: %d\n",somaLinha2);
    printf("\nA soma da Linha Tres é: %d\n",somaLinha3);




	return 0;
}
