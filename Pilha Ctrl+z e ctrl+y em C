#include <stdio.h>
#define MAX 10

    typedef struct{
        int DadosDoUsuario[MAX];
        int topo;
    }
    Pilha;
    
    typedef struct{
        int ReceberDados[MAX];
        int topo;
    }
    Pilha1;
    
    void inicializar (Pilha *p) {
            p->topo = -1;
    }
    int estaVazia(Pilha *p){
        return p->topo == -1;
    }
    int estaCheia(Pilha *p){
        return p->topo == MAX -1;
    }
    
    void push(Pilha *p, int valor) {
        if (estaCheia(p)) return;
        p->DadosDoUsuario[++p->topo] = valor;
        
    }
    
    int pop (Pilha *p){
        if (estaVazia(p)) return -1;
        return p->DadosDoUsuario[--p->topo]; //Desse jeito vai mostrar o segundo push no caso "15" mais se colocar 
        //[p->topo --] vai mostrar o ultimo push 
    }
    
    int peek(Pilha *p){
        if (estaVazia(p)) return -1;
        return p-> DadosDoUsuario[p->topo];
    }
    
int main()
{
